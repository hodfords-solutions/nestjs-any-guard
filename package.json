{
    "name": "@hodfords/nestjs-any-guard",
    "version": "12.2.0",
    "description": "NestJS AnyGuard is a simple guard that allows you to use any guard/or guard in your NestJS application.",
    "author": "",
    "license": "UNLICENSED",
    "type": "module",
    "main": "./index.js",
    "types": "./index.d.ts",
    "exports": {
        ".": {
            "types": "./index.d.ts",
            "import": "./index.js",
            "default": "./index.js"
        },
        "./package.json": "./package.json"
    },
    "engines": {
        "node": ">=20.19.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/hodfords-solutions/nestjs-response.git"
    },
    "scripts": {
        "prebuild": "rimraf dist *.tsbuildinfo",
        "build": "nest build",
        "postbuild": "cp package.json dist && cp README.md dist && cp .npmrc dist",
        "format": "prettier --write \"sample/**/*.ts\" \"lib/**/*.ts\"",
        "start": "nest start -p tsconfig.sample.json",
        "start:dev": "npm run prebuild && nest start --watch -p tsconfig.sample.json",
        "start:debug": "nest start --debug --watch -p tsconfig.sample.json",
        "start:prod": "node dist/sample/main",
        "lint": "eslint \"{sample,apps,lib}/**/*.ts\" --fix",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:cov": "vitest run --coverage",
        "wz-command": "wz-command",
        "prepare": "is-ci || husky",
        "version": "auto-changelog && git add CHANGELOG.md",
        "release:patch": "git add CHANGELOG.md && npm version patch --tag-version-prefix='' -f -m 'chore: release to %s'",
        "release:push": "git push --no-verify && git push --tags --no-verify",
        "lint-staged": "lint-staged",
        "cspell": "cspell"
    },
    "devDependencies": {
        "@hodfords/nestjs-eslint-config": "11.0.2",
        "@hodfords/nestjs-prettier-config": "11.0.1",
        "@nestjs/cli": "12.0.0",
        "@nestjs/common": "12.0.1",
        "@nestjs/core": "12.0.1",
        "@nestjs/platform-express": "12.0.1",
        "@nestjs/schematics": "12.0.0",
        "@nestjs/testing": "12.0.1",
        "@swc/core": "^1.15.18",
        "@types/express": "5.0.3",
        "@types/node": "25.2.0",
        "@types/supertest": "6.0.3",
        "auto-changelog": "2.5.0",
        "cspell": "9.2.0",
        "eslint": "9.33.0",
        "husky": "9.1.7",
        "is-ci": "4.1.0",
        "lint-staged": "16.1.5",
        "prettier": "3.6.2",
        "reflect-metadata": "0.2.2",
        "rimraf": "6.0.1",
        "rxjs": "7.8.2",
        "source-map-support": "0.5.21",
        "supertest": "7.1.4",
        "typescript": "6.0.3",
        "unplugin-swc": "1.5.7",
        "vitest": "4.1.10"
    },
    "peerDependencies": {
        "@nestjs/common": ">=12.0.0",
        "@nestjs/core": ">=12.0.0"
    }
}
